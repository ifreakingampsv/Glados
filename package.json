{
  "name": "glados",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p .next && next dev 2>&1 | tee .next/dev.log",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "test:user": "tsx scripts/make-test-user.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "worker": "tsx scripts/worker.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.7",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.27",
    "pg-boss": "^10.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svix": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@clerk/shared@3.48.0": true,
    "unrs-resolver@1.12.2": true
  }
}
