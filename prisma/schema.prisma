// S0 spine schema. D25 division: mutable descriptive facts = normal tables;
// history = append-only log (event_log). No per-user tables (D30).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// Identity is owned by Clerk (D35); this row exists for spine FKs and is kept
// in sync by webhooks + lazy backstop.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  role      Role     @default(USER)
  invitedAt DateTime? // set when an invite code is redeemed (T03 gate)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// D7/D38b: funnel stays ours — public email capture + single-use codes.
model WaitlistEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model InviteCode {
  id         String    @id @default(cuid())
  code       String    @unique
  createdBy  String?
  redeemedBy String?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Mutable descriptive facts (D25). Profile = field dictionary, JSON-Resume-
// compatible, so the future autofill extension is a renderer (D1-era scope).
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fields    Json
  updatedAt DateTime @updatedAt
}

model TargetRole {
  id        String   @id @default(cuid())
  userId    String
  title     String
  seniority String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Leaf config; keys are allowlisted in the service layer (D37c).
model Preference {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String

  @@unique([userId, key])
}

// First-class spine entity (T05); recruiter view later JOINs this × event_log (D11).
model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  links       Json     @default("[]")
  skills      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([skills], type: Gin)
}

// D24/D27/D33: curated canonical vocabulary + aliases + candidates in one
// table (status); never hard-deleted — merge leaves aliasOfId so old event
// references resolve read-time. parentId = D27 taxonomy (react → frontend).
enum SkillStatus {
  ACTIVE
  CANDIDATE
  RETIRED
}

model Skill {
  id         String      @id @default(cuid())
  name       String      @unique // normalized form
  display    String
  definition String?     // D70: generated once via gateway, cached (D4)
  parentId   String?
  status     SkillStatus @default(ACTIVE)
  aliasOfId  String?     // set on merge (D33b)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  aliases    SkillAlias[]

  @@index([parentId])
  @@index([status])
}

model SkillAlias {
  id      String @id @default(cuid())
  alias   String @unique // normalized
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])
}

model UserSkill {
  id              String    @id @default(cuid())
  userId          String
  skillId         String
  claimedLevel    Int? // self-rating 1–5; NEVER in the score (D24)
  claimOrigins    String[]  @default([]) // e.g. ["resume", "linkedin", "self"]
  staleOrigins    String[]  @default([]) // per-source staleness flags (D55a/D72)
  score           Float     @default(0)
  level           Int       @default(0)
  lastEvidencedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, skillId])
  @@index([skillId])
}

// Append-only history (D25). Levels NEVER live here; points are the
// base_points(type, source) snapshot at write time, so config changes never
// rewrite history. occurred_at is clamped to ≤ now (decay can't be gamed).
model EventLog {
  id         String   @id @default(cuid())
  userId     String
  type       String
  points     Int      @default(0)
  occurredAt DateTime
  source     String
  skills     String[] @default([])
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([skills], type: Gin)
}

// Tunables live as config rows, not code constants (D28 philosophy):
// levels.bands, points.types, points.sourceWeights, quotas, budget.
model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// D35: agent auth. Hash at rest, shown once, prefix lookup, revocable.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    @unique
  hash       String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// D26: BYO keys as encrypted blobs; plaintext never touches the DB.
model Credential {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  last4      String
  data       String // base64(iv:tag:ciphertext), AES-256-GCM under the KEK
  createdAt  DateTime @default(now())

  @@unique([userId, provider])
}

// D26: the routing table is DATA — provider swaps are row edits.
model ProviderRoute {
  id           String  @id @default(cuid())
  feature      String
  provider     String
  model        String
  endpoint     String
  costPer1kUsd Float   @default(0)
  isActive     Boolean @default(true)
}

// D38c: one row per gateway call; counters + energy in the same transaction.
model Usage {
  id             String   @id @default(cuid())
  userId         String
  feature        String
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  costUsd        Float
  via            String // byo | platform
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyCounter {
  id     String @id @default(cuid())
  userId String
  date   String // YYYY-MM-DD (UTC)
  count  Int    @default(0)

  @@unique([userId, date])
}

// Per-feature and hashed-IP daily counters for S1 attractor caps (D28/D51/D60).
model RateLimitCounter {
  id        String @id @default(cuid())
  bucketKey String
  date      String // YYYY-MM-DD (UTC)
  count     Int    @default(0)

  @@unique([bucketKey, date])
}

// D28/D36: energy denominated in bars (1 bar = worst-case $0.10).
model EnergyAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  balance           Float     @default(0)
  lastGrantDate     String? // YYYY-MM-DD (UTC) — lazy daily grant
  lastEarnedAt      DateTime? // weekly earned replenishment (T14)
  welcomeBarGrantedAt DateTime? // D84: signup bonus bar, granted exactly once
}

model FeatureFlag {
  key       String   @id // the feature name
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// D5/D28: hard alert tripwire — the budget alert stops the crowd.
model BudgetAlert {
  id        String   @id @default(cuid())
  month     String   @unique // YYYY-MM
  amountUsd Float
  createdAt DateTime @default(now())
}

// D4: content-hash cache for gateway calls (definitions, parses, JD extracts, reviews).
model GatewayCache {
  cacheKey  String   @id
  feature   String
  content   String
  createdAt DateTime @default(now())

  @@index([feature])
}

// D56/D71: Structured work experience rows earning evidence via duration * specificity.
model WorkExperience {
  id                String   @id @default(cuid())
  userId            String
  employer          String
  title             String
  period            String
  durationMonths    Int      @default(12)
  kind              String   @default("job") // job | internship
  description       String
  skills            String[] @default([])
  origin            String   @default("resume") // resume | linkedin | web
  staleOrigins      String[] @default([])
  promotedProjectId String?
  lastConfirmedAt   DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// D9/D30/D37a: Resume blocks with lock status, source_ref, and JD-bound variants.
model ResumeBlock {
  id                    String   @id @default(cuid())
  userId                String
  kind                  String   // summary | experience | skill_group | education | custom
  title                 String   @default("")
  content               String
  status                String   @default("draft") // draft | locked
  sortOrder             Int      @default(0)
  sourceRefType         String?  // project | work_experience
  sourceRefId           String?
  parentId              String?
  fromJdId              String?
  manualOverrideForJdId String?
  origin                String   @default("web") // resume | linkedin | web
  staleOrigins          String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, sortOrder])
  @@index([parentId])
}

// D55a/D72: Persistent diff-and-stage table for re-uploaded resume/LinkedIn files.
model ResumeImportStaging {
  id            String   @id @default(cuid())
  userId        String
  source        String   // resume | linkedin
  storageKey    String?
  parsedPayload Json
  diffItems     Json
  status        String   @default("pending") // pending | applied | declined
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
}

// D61: Per-user persisted job descriptions with FIFO soft cap and canonical skill requirements.
model JobDescription {
  id             String   @id @default(cuid())
  userId         String
  title          String
  company        String?
  rawText        String
  contentHash    String
  requiredSkills Json     // Array<{ skillId: string; expectedLevel: number; category?: string }>
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
}

// D51/D61: Anonymous scanner TTL side table claimed on signup.
model AnonymousScan {
  id              String    @id @default(cuid())
  sessionToken    String    @unique
  jdTitle         String
  jdText          String
  resumeText      String?
  fitScore        Int
  topGaps         Json
  fullResult      Json
  expiresAt       DateTime
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
}

// S1.5: Per-skill calibration quiz banks (D41/D59/D70/D78).
model QuizBank {
  id          String         @id @default(cuid())
  skillId     String
  band        String         // L0-1 | L2-3 | L4-5
  version     Int            @default(1)
  status      String         @default("generating") // generating | live | retired | needs_review
  generatedAt DateTime       @default(now())
  questions   QuizQuestion[]

  @@unique([skillId, band, version])
  @@index([skillId, status])
}

model QuizQuestion {
  id           String   @id @default(cuid())
  bankId       String
  bank         QuizBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  prompt       String
  options      Json     // string[]
  correctIndex Int
  tags         String[] @default([])

  @@index([bankId])
}

// S1.5: Staircase quiz sessions and client-clock telemetry answers (D59/D76/D77).
model QuizSession {
  id             String       @id @default(cuid())
  userId         String
  skillId        String
  bankVersion    Int
  bandStart      String
  bandSettled    String?
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  outcome        String       @default("in_progress") // in_progress | completed | abandoned
  questionsAsked Int          @default(0)
  correctCount   Int          @default(0)
  answers        QuizAnswer[]

  @@index([userId, skillId])
  @@index([skillId, outcome])
}

model QuizAnswer {
  id         String      @id @default(cuid())
  sessionId  String
  session    QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  band       String
  correct    Boolean
  ms         Int
  position   Int

  @@index([sessionId, position])
  @@index([questionId])
}

// S1.5: Externally verifiable or claim-tier certificates (D57/D75).
model Certificate {
  id         String    @id @default(cuid())
  userId     String
  provider   String
  verifyUrl  String
  verifiedAt DateTime?
  courseName String
  issuedOn   DateTime
  skills     String[]  @default([])
  storageKey String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

// S2: mock interview sessions (D79/D80/D82). Columns = query surface (status,
// mode, scope); grounding refs + spine content version snapshot + interviewer
// config live in payload (event-log project_id-reference pattern, D25/D82).
model InterviewSession {
  id        String           @id @default(cuid())
  userId    String
  scope     String // project | portfolio | application (v1: project)
  mode      String // quick | deep
  status    String           @default("active") // active | completed | abandoned | graded
  origin    String           @default("web") // surface: web | mcp (D88b)
  payload   Json
  startedAt DateTime         @default(now())
  completedAt DateTime?
  abandonedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  turns     InterviewTurn[]
  reports   InterviewReport[]

  @@index([userId, status])
}

// S2 (D81/D82): one report per graded session. Dimension scores + evidence
// basis are columns (briefing aggregates GROUP BY them); per-question verdicts,
// groundedness findings, coaching and model/prompt versions live in payload.
// Nullable dimensions = tombstone strip (D82).
model InterviewReport {
  id             String           @id @default(cuid())
  sessionId      String           @unique
  session        InterviewSession @relation(fields: [sessionId], references: [id])
  techDepth      Int?
  problemSolving Int?
  tradeoffs      Int?
  communication  Int?
  composure      Int?
  evidenceBasis  String           @default("intrinsic") // records | intrinsic (D79)
  readinessBand  String? // Developing | Ready | Strong — deterministic
  payload        Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([sessionId])
}

// S2: one row per turn; telemetry columns are PLAIN columns by design (D82
// deliberate D25 deviation — quiz-precedent justification: aggregate telemetry).
model InterviewTurn {
  id           String           @id @default(cuid())
  sessionId    String
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  idx          Int
  questionText String
  answerText   String?
  pushesUsed   Int              @default(0)
  durationMs   Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([sessionId, idx])
}

// S2 (D79): ADR-lite per-project decision records — CLAIM-tier (never
// evidence points), AI-drafted from interview debriefs (user confirms) or
// written manually; plugin mining arrives with the MCP surface.
model DecisionRecord {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  choice       String
  alternatives String[]  @default([])
  rationale    String
  status       String    @default("draft") // draft | confirmed
  source       String    @default("manual") // manual | interview_debrief | plugin
  sessionId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, projectId])
}
